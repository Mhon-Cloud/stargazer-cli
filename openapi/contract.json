{
  "about": "What stargazer needs from the public API. tests/contract.rs checks it matches the code (every call is listed) and openapi.json (every operation and field exists). The platform repo checks its new spec against this file before deploying the API gateway (management_page/backend/api_gateway/apidocs/check_api.py). Fields: dot paths, [] = each item of an array; request = body fields the CLI sends, response = fields it reads to work (table-only columns are left out: a missing one just shows '-').",
  "operations": [
    {
      "method": "GET",
      "path": "/api/v1/me/credit",
      "used_by": ["login", "credit"],
      "response": ["credit", "currency"]
    },
    {
      "method": "GET",
      "path": "/api/v1/auth/me",
      "used_by": ["whoami"],
      "response": ["user.email"]
    },
    {
      "method": "GET",
      "path": "/api/v1/projects",
      "used_by": ["projects list"],
      "response": ["projects[].id", "projects[].name", "projects[].my_role"]
    },
    {
      "method": "GET",
      "path": "/api/v1/availability-zones",
      "used_by": ["zones list"],
      "response": ["availability_zones[].id", "availability_zones[].name"]
    },
    {
      "method": "GET",
      "path": "/api/v1/servers",
      "used_by": ["servers list", "servers start|stop|rename|resize|delete (name lookup)"],
      "response": ["servers[].id", "servers[].name", "servers[].status", "servers[].project.id", "servers[].project.name"]
    },
    {
      "method": "POST",
      "path": "/api/v1/servers/{id}/actions",
      "used_by": ["servers start|stop|rename|resize|delete"],
      "request": ["action", "name", "cores", "memory_mb", "disk_gb"],
      "response": ["server"]
    },
    {
      "method": "GET",
      "path": "/api/v1/containers",
      "used_by": ["containers list", "containers start|stop|delete|logs (name lookup)"],
      "response": ["containers[].id", "containers[].name", "containers[].number", "containers[].status", "containers[].project.id", "containers[].project.name"]
    },
    {
      "method": "POST",
      "path": "/api/v1/containers/{id}/start",
      "used_by": ["containers start"],
      "response": ["container"]
    },
    {
      "method": "POST",
      "path": "/api/v1/containers/{id}/stop",
      "used_by": ["containers stop"],
      "response": ["container"]
    },
    {
      "method": "DELETE",
      "path": "/api/v1/containers/{id}",
      "used_by": ["containers delete"],
      "response": ["container"]
    },
    {
      "method": "GET",
      "path": "/api/v1/containers/{id}/logs",
      "used_by": ["containers logs"],
      "query": ["tail"],
      "response": ["logs"]
    },
    {
      "method": "GET",
      "path": "/api/v1/dns",
      "used_by": ["dns list"],
      "response": ["records[].id", "records[].name"]
    }
  ]
}
